
#  CREAR ESTE ARCHIVO COMO .env
#       cp .env.example .env
#       python3 -c "import secrets; print(secrets.token_hex(32))"
#       mysql -h 127.0.0.1 -P 3306 -u root -p
#     Y correr:
#       CREATE DATABASE IF NOT EXISTS flskbase CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#       CREATE USER IF NOT EXISTS 'flskbase_user'@'localhost' IDENTIFIED BY 'TuPassword123!';
#       GRANT ALL PRIVILEGES ON flskbase.* TO 'flskbase_user'@'localhost';
#       FLUSH PRIVILEGES;
#       EXIT;
#     (Si la contraseña tiene @ : / # en la URL de abajo, cámbiala o escápala.)
#
#  6) CREAR LAS TABLAS (las migraciones ya vienen en el repo)
#       flask db upgrade
#     OJO: NO correr "flask db init" (la carpeta migrations/ ya existe).
#
#  7) CREAR ROLES Y EL PRIMER ADMIN
#       flask seed                        -> crea los roles admin y usuario
#       flask crear-usuario               -> te pide nombre, email y password (rol admin)
#
#  8) CORRER LA APP
#       flask run                         -> http://127.0.0.1:5000
#
#  ---------------------------------------------------------------
#  SI TE DAN UNA COMPU CON WINDOWS (instalar todo desde 0)
#  ---------------------------------------------------------------
#  1) Abrir "Terminal" o "PowerShell" y pegar:
#       winget install Python.Python.3.12
#       winget install Git.Git
#       winget install ApacheFriends.Xampp.8.2
#     Si winget no existe, descargar a mano:
#       Python -> python.org/downloads  (MARCAR "Add python.exe to PATH")
#       Git    -> git-scm.com/download/win
#       XAMPP  -> apachefriends.org  (trae MySQL, root SIN password)
#
#  2) CERRAR y volver a abrir la terminal (para que reconozca python y git).
#     Probar:  python --version   y   git --version
#
#  3) Abrir "XAMPP Control Panel" -> botón Start en MySQL.
#
#  4) Entrar a MySQL y crear la base (paso 5 de arriba):
#       C:\xampp\mysql\bin\mysql -u root
#
#  5) Seguir los pasos de arriba con estas diferencias en Windows:
#       python -m venv env               (python, no python3)
#       env\Scripts\activate
#       copy .env.example .env           (copy, no cp)
#       notepad .env                     (para editarlo)
#     Si PowerShell no deja activar el env:
#       Set-ExecutionPolicy -Scope CurrentUser RemoteSigned
#     (o usar "cmd" en lugar de PowerShell)
#
#  ---------------------------------------------------------------
#  AGREGAR UN MÓDULO NUEVO (ej. productos)
#    a) Modelo en app/models.py
#    b) flask db migrate -m "productos"   -> revisar el archivo generado
#    c) flask db upgrade
#    d) Copiar la carpeta app/usuarios/ como app/productos/ y adaptar
#       (__init__.py, forms.py, routes.py) + templates/productos/
#    e) Registrar el blueprint en app/__init__.py y el link en layout.html
#    f) git add . && git commit -m "Módulo productos"
#
#  ERRORES COMUNES
#    - 1045 Access denied          -> usuario/password de DATABASE_URL no coinciden con MySQL
#    - 2002 Can't connect (socket) -> usar -h 127.0.0.1 -P 3306
#    - 1049 Unknown database       -> falta el CREATE DATABASE del paso 5
#    - "Table doesn't exist"       -> falta flask db upgrade
#    - "No existe el rol"          -> falta flask seed
#    - zsh: command not found: mysql -> usar la ruta completa del cliente
#        (DBngin: /Users/Shared/DBngin/mysql/*/bin/mysql)
# =====================================================================

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DATABASE_URL=mysql+pymysql://flskbase_user:TuPassword123!@localhost:3306/flskbase
